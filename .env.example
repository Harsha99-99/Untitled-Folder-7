# .env.example — copy to .env and fill in. .env is gitignored; never commit it.
# The relay (hub.py) reads HUB_* directly. The rest document what the cloud
# migration (see the production plan) will consume — they are not read by the
# current desktop build.

# ---- relay (hub.py) --------------------------------------------------------
HUB_PORT=8000
# Gate for the monitor/listener role. Set a long random value in production so
# the monitor link stays stable across restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_TOKEN=

# ---- Supabase (recording storage + auth, per the production plan) ----------
# Project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=
# Server-side only. NEVER ship this to the browser — it bypasses row-level
# security. Used by the recorder to upload WAVs and write session rows.
SUPABASE_SERVICE_ROLE_KEY=
# Safe to expose to the browser (RLS-scoped). Used by the dashboard for auth.
SUPABASE_ANON_KEY=
# Storage bucket that holds recordings (kept private; read via signed URLs).
SUPABASE_RECORDINGS_BUCKET=recordings
